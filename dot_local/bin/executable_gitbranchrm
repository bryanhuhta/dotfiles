#!/bin/bash
## Delete local git branches except master, main, and next.
##
## Uses `git branch -d` (safe delete) so only fully-merged
## branches are removed. Additional branch names to keep can
## be passed as arguments.
##
## Usage: gitbranchrm [-h] [branch...]
##   -h         Print this help message
##   branch     Additional branch names to keep (master, main,
##              and next are always kept)

set -euo pipefail

if [[ "${1:-}" == "-h" ]]; then
  grep '^##' "$0" | sed -E 's/^## ?//'
  exit 0
fi

ignore_pattern="master|main|next"
for branch in "$@"; do
  ignore_pattern="${ignore_pattern}|${branch}"
done

git for-each-ref --format '%(refname:short)' refs/heads \
  | grep -vE "^(${ignore_pattern})$" \
  | xargs git branch -d
