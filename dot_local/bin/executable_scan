#!/bin/bash
## Run trivy and grype in a Docker container against the current directory.
##
## Mounts the cwd as a read-only volume at /workspace and bind-mounts the
## host Docker socket so the scanners can pull or build images to scan.
##
## With no command, drops into an interactive sh shell with trivy and
## grype on PATH. With arguments, runs them inside the container.
##
## Usage: scan [-h] [-f] [args...]
##   -h    Print this help message
##   -f    Force rebuild the Docker image before running
##
## Examples:
##   scan                          # interactive shell
##   scan trivy fs .               # scan cwd filesystem
##   scan trivy image alpine:3.23  # scan a remote image
##   scan grype dir:/workspace     # grype the cwd

set -euo pipefail

if [[ "${1:-}" == "-h" ]]; then
  grep '^##' "$0" | sed -E 's/^## ?//'
  exit 0
fi

image="scan-tools"
dockerfile="$(chezmoi source-path)/scan/Dockerfile"
force=false

while [[ "${1:-}" == -* ]]; do
  case "${1:-}" in
    -f) force=true; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done

if [[ ! -f "$dockerfile" ]]; then
  echo "Error: Dockerfile not found at $dockerfile"
  exit 1
fi

if $force; then
  docker rmi -f "$image" &>/dev/null || true
fi

if ! docker image inspect "$image" &>/dev/null; then
  docker build -t "$image" -f "$dockerfile" "$(dirname "$dockerfile")"
fi

docker run --rm -it \
  -v "$(pwd):/workspace:ro" \
  -v /var/run/docker.sock:/var/run/docker.sock \
  "$image" "$@"
