#!/bin/bash
## Run Claude in a sandboxed read-only Docker container.
##
## Builds the Docker image from the Dockerfile in the chezmoi source
## directory if it doesn't already exist.
##
## Authenticates by reading the Claude Code credential from the macOS
## Keychain and passing it as ANTHROPIC_API_KEY to the container.
##
## Usage: sandbox [-h] [-f] [-w] [args...]
##   -h    Print this help message
##   -f    Force rebuild the Docker image before running
##   -w    Mount the working directory as writable (default: read-only)

set -euo pipefail

if [[ "${1:-}" == "-h" ]]; then
  grep '^##' "$0" | sed -E 's/^## ?//'
  exit 0
fi

image="claude-sandbox"
dockerfile="$(chezmoi source-path)/claude-sandbox/Dockerfile"
force=false
writable=false

while [[ "${1:-}" == -* ]]; do
  case "${1:-}" in
    -f) force=true; shift ;;
    -w) writable=true; shift ;;
    *) break ;;
  esac
done

if [[ ! -f "$dockerfile" ]]; then
  echo "Error: Dockerfile not found at $dockerfile"
  exit 1
fi

if $force; then
  docker rmi -f "$image" &>/dev/null
fi

if ! docker image inspect "$image" &>/dev/null; then
  docker build -t "$image" -f "$dockerfile" "$(chezmoi source-path)"
fi

api_key=$(security find-generic-password -s "Claude Code" -w 2>/dev/null) || true
if [[ -z "${api_key:-}" ]]; then
  echo "Error: could not read Claude Code credential from macOS Keychain"
  echo "Run 'claude auth login' to authenticate first"
  exit 1
fi

mount_opts="ro"
if $writable; then
  mount_opts="rw"
fi

docker run --rm -it \
  -e "ANTHROPIC_API_KEY=${api_key}" \
  -v "$(pwd):/workspace:${mount_opts}" \
  "$image" "$@"
