#!/bin/bash
## Authenticate via gcloud and AWS SSO for a given environment.
##
## Checks if gcloud auth is active before prompting login. Use -f
## to force re-authentication. Requires DEPLOY_TOOLS_DIR to be set.
##
## Usage: sso [-h] [-f|--force] [dev|ops|prod]
##   -h, --help     Print this help message
##   -f, --force    Force gcloud re-authentication
##   dev            Authenticate to the dev environment (default)
##   ops            Authenticate to the ops environment
##   prod           Authenticate to the prod environment

set -euo pipefail

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  grep '^##' "$0" | sed -E 's/^## ?//'
  exit 0
fi

env="dev"
force=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -f|--force)
      force=true
      shift
      ;;
    dev|ops|prod)
      env="$1"
      shift
      ;;
    *)
      echo "Unknown option: $1"
      echo "Usage: sso [-f|--force] [dev|ops|prod]"
      exit 1
      ;;
  esac
done

if [[ -z "${DEPLOY_TOOLS_DIR:-}" ]]; then
  echo "Error: DEPLOY_TOOLS_DIR is not set."
  exit 1
fi

cd "${DEPLOY_TOOLS_DIR}" || {
  echo "Error: Cannot cd into ${DEPLOY_TOOLS_DIR}"
  exit 1
}

if $force; then
  gcloud auth login
elif ! gcloud auth print-access-token >/dev/null 2>&1; then
  gcloud auth login
fi

case "$env" in
  dev)
    ./scripts/sso/aws.sh dev
    ;;
  ops)
    ./scripts/sso/aws.sh ops
    ;;
  prod)
    ./scripts/sso/aws.sh prod
    ;;
esac
