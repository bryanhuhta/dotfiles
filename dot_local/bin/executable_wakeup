#!/bin/bash
## Keep the display awake by running caffeinate in the background.
##
## With no arguments the display stays awake until stopped. Pass a duration
## to stop automatically after it elapses. Starting a new session replaces
## any wakeup session already running, so pids never pile up, and the
## session is tracked in a state file so it can be checked or stopped from
## any terminal, even after the one that started it is closed.
##
## Durations are a number with an optional unit suffix: s (seconds, default),
## m (minutes), or h (hours).
##
## Usage: wakeup [-h] [duration|status|stop]
##   -h        Print this help message
##   status    Show whether a wakeup session is active and time remaining
##   stop      Stop the active wakeup session
##
## Examples:
##   wakeup          Stay awake indefinitely
##   wakeup 90       Stay awake for 90 seconds
##   wakeup 45m      Stay awake for 45 minutes
##   wakeup 2h       Stay awake for 2 hours
##   wakeup status   Check the active session
##   wakeup stop     Stop the active session

set -euo pipefail

if [[ "${1:-}" == "-h" ]]; then
  grep '^##' "$0" | sed -E 's/^## ?//'
  exit 0
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/wakeup"
state_file="$state_dir/session"
mkdir -p "$state_dir"

# Populates pid/start/seconds from the state file. If the recorded pid is no
# longer running (e.g. a timed session finished naturally while no terminal
# was watching), clears the stale state instead of reporting it.
read_state() {
  pid=""
  start=""
  seconds=""

  if [[ -f "$state_file" ]]; then
    IFS=' ' read -r pid start seconds < "$state_file"
    if [[ -z "$pid" ]] || ! kill -0 "$pid" 2>/dev/null; then
      pid=""
      start=""
      seconds=""
      rm -f "$state_file"
    fi
  fi
}

case "${1:-}" in
  status)
    read_state
    if [[ -z "$pid" ]]; then
      echo "wakeup: no active session"
      exit 0
    fi
    if [[ -n "$seconds" ]]; then
      remaining=$(( start + seconds - $(date +%s) ))
      if (( remaining <= 0 )); then
        echo "wakeup: no active session"
        exit 0
      fi
      echo "Display awake, ${remaining}s remaining (pid $pid)"
    else
      echo "Display awake indefinitely (pid $pid)"
    fi
    exit 0
    ;;
  stop)
    read_state
    if [[ -z "$pid" ]]; then
      echo "wakeup: no active session"
      exit 0
    fi
    kill "$pid" 2>/dev/null || true
    rm -f "$state_file"
    echo "Stopped wakeup session (pid $pid)"
    exit 0
    ;;
esac

duration="${1:-}"
seconds=""

if [[ -n "$duration" ]]; then
  if [[ ! "$duration" =~ ^([0-9]+)([smh]?)$ ]]; then
    echo "wakeup: invalid duration '$duration' (expected e.g. 90, 45m, 2h)" >&2
    exit 1
  fi

  value="${BASH_REMATCH[1]}"
  unit="${BASH_REMATCH[2]:-s}"

  case "$unit" in
    s) seconds=$((value)) ;;
    m) seconds=$((value * 60)) ;;
    h) seconds=$((value * 3600)) ;;
  esac

  if [[ "$seconds" -eq 0 ]]; then
    echo "wakeup: duration must be greater than zero" >&2
    exit 1
  fi
fi

read_state
if [[ -n "$pid" ]]; then
  kill "$pid" 2>/dev/null || true
  echo "Replaced existing wakeup session (pid $pid)"
fi

if [[ -n "$seconds" ]]; then
  nohup caffeinate -d -t "$seconds" >/dev/null 2>&1 &
  new_pid=$!
  echo "$new_pid $(date +%s) $seconds" > "$state_file"
  echo "Display awake for ${seconds}s (pid $new_pid)"
else
  nohup caffeinate -d >/dev/null 2>&1 &
  new_pid=$!
  echo "$new_pid $(date +%s) " > "$state_file"
  echo "Display awake until killed (pid $new_pid)"
fi
