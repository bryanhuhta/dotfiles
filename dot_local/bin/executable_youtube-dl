#!/bin/bash
## Run yt-dlp (the maintained youtube-dl fork) in a Docker container.
##
## Builds the Docker image from youtube-dl/Dockerfile in the chezmoi
## source directory if it does not already exist. Mounts the current
## working directory as /downloads so files saved by yt-dlp land here.
##
## Accepts any number of URLs. Wrapper flags must come before the first
## URL. Everything from the first URL onward is passed directly to
## yt-dlp. To pass yt-dlp flags that would collide with wrapper flags,
## put them after a `--` separator.
##
## Usage: youtube-dl [-h] [-f] [--] [yt-dlp options...] <url>...
##   -h    Print this help message
##   -f    Force rebuild the Docker image before running
##
## Examples:
##   youtube-dl https://youtu.be/aaa https://youtu.be/bbb
##   youtube-dl -f -- -f bestaudio https://...
##     (wrapper -f rebuilds the image; yt-dlp -f selects the format)

set -euo pipefail

if [[ "${1:-}" == "-h" ]]; then
  grep '^##' "$0" | sed -E 's/^## ?//'
  exit 0
fi

image="youtube-dl"
context="$(chezmoi source-path)/youtube-dl"
dockerfile="${context}/Dockerfile"
rebuild=false

while [[ $# -gt 0 ]]; do
  case "${1}" in
    -f) rebuild=true; shift ;;
    --) shift; break ;;
    -*) echo "Error: unknown wrapper flag '$1'" >&2
        echo "Use '--' to pass flags through to yt-dlp." >&2
        echo "Example: youtube-dl -- $1" >&2
        exit 1 ;;
    *) break ;;
  esac
done

if [[ ! -f "$dockerfile" ]]; then
  echo "Error: Dockerfile not found at $dockerfile"
  exit 1
fi

if $rebuild; then
  docker rmi -f "$image" &>/dev/null || true
fi

if ! docker image inspect "$image" &>/dev/null; then
  docker build -t "$image" -f "$dockerfile" "$context"
fi

# Seeded with --rm so the array is never empty; bash 3.2 (macOS /bin/bash)
# errors on empty array expansion under set -u.
run_flags=(--rm)
if [[ -t 0 && -t 1 ]]; then
  run_flags+=(-it)
fi

docker run "${run_flags[@]}" \
  --init \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  -v "$(pwd):/downloads" \
  "$image" "$@"
