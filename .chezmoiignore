{{- /*
This tree is the source root for the Linux profiles only. personal-mac and
work-mac have their own self-contained source directories at the top of the
repository, selected with `sourceDir` in the machine-local chezmoi.toml.
*/ -}}
{{- $profile := dig "profile" "" . -}}
{{- if not (has $profile (list "personal-bazzite" "personal-fedora")) }}
{{ fail (printf "profile %q cannot be applied from this source directory — set `profile` in chezmoi.toml to personal-bazzite or personal-fedora, or point `sourceDir` at the personal-mac / work-mac directory for a Mac" $profile) }}
{{- end }}

# Profile source directories with their own sourceDir; never targets of this one.
personal-mac/
work-mac/

# Repository audit notes
BUGS.md

CLAUDE.md
README.md
SETUP.md

# Claude sandbox
claude-sandbox/

# youtube-dl docker build context
youtube-dl/

# scan (trivy + grype) docker build context
scan/

# utility (ffmpeg + imagemagick) docker build context
utility/

# Symlink targets for ~/.claude (externally modified files)
claude-home/

# Zed
zed_settings.json

{{- if not (hasKey .git "signingkey") }}
# No signing key configured on this machine
.ssh/allowed_signers
{{- end }}

{{- if eq .profile "personal-bazzite" }}
# Not loaded on the personal-bazzite profile
.local/bin/movtomp4
.local/bin/p
.local/bin/sso
.local/bin/mermaid
.local/bin/ts2date
.local/bin/gifify
.local/bin/slackify
.local/bin/jpegify
.local/bin/scan
.local/bin/docker-clean

# Ghostty isn't installed on personal-bazzite (see dot_Brewfile.tmpl)
.config/ghostty

# GNOME-on-Fedora-only key remap
swap-caps-escape.sh
{{- end }}

{{- if eq .profile "personal-fedora" }}
# Not loaded on the personal-fedora profile
.Brewfile
.local/bin/**
.config/zed
install-zsh.sh
{{- end }}
