# Login-shell setup: PATH and one-time / slow tool initialization.
#
# Runs after /etc/zprofile (which runs path_helper), so PATH modifications
# here take precedence over /etc/paths and /etc/paths.d entries.
#
# Exports here are inherited by all child shells, so .zshrc aliases that
# reference these variables resolve correctly even in non-login subshells.

# Homebrew (sets PATH, MANPATH, INFOPATH, HOMEBREW_PREFIX, ...).
{{- if eq .profile "personal-bazzite" }}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}

# Utility scripts
export PATH="$HOME/.local/bin:$PATH"

# OrbStack
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
