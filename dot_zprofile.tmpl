# Login-shell setup: PATH and one-time / slow tool initialization.
#
# Runs after /etc/zprofile (which runs path_helper), so PATH modifications
# here take precedence over /etc/paths and /etc/paths.d entries.
#
# Exports here are inherited by all child shells, so .zshrc aliases that
# reference these variables resolve correctly even in non-login subshells.

# Homebrew (sets PATH, MANPATH, INFOPATH, HOMEBREW_PREFIX, ...).
{{- if or (eq .profile "personal") (eq .profile "work") }}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- end }}
{{- if eq .profile "personal-bazzite" }}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{- end }}

# Utility scripts
export PATH="$HOME/.local/bin:$PATH"

# Rust / cargo
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

{{- if or (eq .profile "personal") (eq .profile "work") }}

# Go
export GOPATH="$HOME/go"
export PATH="$PATH:$HOME/go/bin"

# Dotnet
export DOTNET_CLI_TELEMETRY_OPTOUT=1

# node, nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
{{- end }}

{{- if eq .profile "work" }}

# Task list (Tuxedo)
export TODO_DIR="${XDG_DATA_HOME}/tuxedo"
alias todo=tuxedo

# tuicr (aka git review tui)
alias review=tuicr

# Deployment tools
export DEPLOY_TOOLS_DIR="$HOME/grafana/deployment_tools"
export PATH="$PATH:${DEPLOY_TOOLS_DIR}/scripts/gcom"

# GCOM
export GCOM_CONFIG_DIR="$HOME/.gcom"

# k8s contexts
export KUBECONFIG="$HOME/.kube/config":"$HOME/.kube/config-kind"

# Google cloud sdk components (gcloud itself is linked into brew's bin by
# the gcloud-cli cask; components like gke-gcloud-auth-plugin land here)
export PATH="$PATH:${HOMEBREW_PREFIX}/share/google-cloud-sdk/bin"

# jenv (after other PATH modifications so shims take precedence)
if command -v jenv &>/dev/null; then
  eval "$(jenv init -)"
fi
{{- end }}

# OrbStack
source ~/.orbstack/shell/init.zsh 2>/dev/null || :
