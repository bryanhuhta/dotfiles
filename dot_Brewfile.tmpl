# Packages installed via `brew bundle --global` on brew-based profiles.
# This file is only used on profiles whose install script invokes brew bundle.

brew "chezmoi"             # Dotfile manager
brew "fzf"                 # Fuzzy finder (used by the nvim fzf plugin)
brew "jq"                  # Parse JSON from the command line
brew "neovim"              # Neovim, of course
brew "the_silver_searcher" # ag (better version of grep)
brew "tree"                # Display directories as trees
brew "tree-sitter-cli"     # Compiles nvim-treesitter grammars

{{ if eq .profile "personal-bazzite" }}
# Development tools
cask "claude-code" # Claude Code
brew "gh"          # GitHub cli
brew "git"         # Version control system
brew "git-lfs"     # Large file storage (gitconfig declares required lfs filters)
brew "go"          # go programming language
brew "zig"         # Zig programming language

# Neovim dependencies
brew "gopls"       # Go language server
brew "zls"         # Zig language server
{{ end }}
