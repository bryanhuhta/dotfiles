cask "claude-code" # Claude Code
brew "gh"          # GitHub cli
brew "git"         # Version control system
brew "git-lfs"     # Large file storage (gitconfig declares required lfs filters)
brew "go"          # go programming language
brew "zig"         # Zig programming language

# Neovim dependencies
