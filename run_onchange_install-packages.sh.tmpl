#!/bin/bash
## Install Homebrew packages declared in .chezmoidata/packages.toml.
##
## The package names are rendered directly into the brew commands below, so
## chezmoi re-runs this script whenever the list changes (run_onchange keys
## off the rendered content). Comments in packages.toml don't render here, so
## editing a comment alone won't trigger a re-run.
##
## Converges only: `brew install` skips already-installed packages and does
## not upgrade them. Upgrade intentionally with `brew upgrade`.

set -euo pipefail

export HOMEBREW_NO_AUTO_UPDATE=1

{{ range .packages.taps -}}
brew tap {{ . | quote }}
{{ end -}}

brew install{{ range .packages.brews }} \
  {{ . | quote }}{{ end }}

brew install --cask{{ range .packages.casks }} \
  {{ . | quote }}{{ end }}
