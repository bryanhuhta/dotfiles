# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="custom-eastwood"
DISABLE_UPDATE_PROMPT="true"
plugins=(git virtualenv)

source $ZSH/oh-my-zsh.sh
export EDITOR=nvim

# Homebrew.
export HOMEBREW_PREFIX="/opt/homebrew";
export HOMEBREW_CELLAR="/opt/homebrew/Cellar";
export HOMEBREW_REPOSITORY="/opt/homebrew";
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin${PATH+:$PATH}";
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:";
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}";

# Go environment variables.
export GOPATH=$HOME/go
export PATH=$PATH:$HOME/go/bin

# Allows code to be used on the commandline.
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# Opt out of dotnet telementry.
export DOTNET_CLI_TELEMETRY_OPTOUT=1

export GPG_TTY=$(tty)

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Make ag more usable
alias ag="ag --nogroup"

# Make chezmoi easier to use
alias z="chezmoi"

# nvim shortcut
alias e="$EDITOR"

# Utility scripts
export PATH="$HOME/.local/bin:$PATH"

{{- if eq .profile "work" }}

# Work laptop

# Go
export GOPRIVATE="github.com/grafana/grafana-com-clients"

# git
alias gfm="git fetch && git merge"
alias gbomb="git restore --source HEAD --staged --worktree . && git clean -fd"

# Deployment tools
export DEPLOY_TOOLS_DIR="$HOME/grafana/deployment_tools"
alias tklocal="${DEPLOY_TOOLS_DIR}/scripts/tanka/tk"
alias ignore="${DEPLOY_TOOLS_DIR}/scripts/flux/ignore.sh"
alias vaultd="VAULT_INSTANCE=dev GRAFANA_TEAM=pyroscope ${DEPLOY_TOOLS_DIR}/scripts/vault/vault-token"
alias vaultp="VAULT_INSTANCE=prod GRAFANA_TEAM=pyroscope ${DEPLOY_TOOLS_DIR}/scripts/vault/vault-token"

# GCOM
export GCOM_CONFIG_DIR="$HOME/.gcom"
alias gcomd="${DEPLOY_TOOLS_DIR}/scripts/gcom/gcom-dev"
alias gcomo="${DEPLOY_TOOLS_DIR}/scripts/gcom/gcom-ops"
alias gcomp="${DEPLOY_TOOLS_DIR}/scripts/gcom/gcom"
alias gcomd-reconcile="${DEPLOY_TOOLS_DIR}/scripts/gcom/gcom-dev-reconcile"
alias gcomo-reconcile="${DEPLOY_TOOLS_DIR}/scripts/gcom/gcom-ops-reconcile"
alias gcom-reconcile="${DEPLOY_TOOLS_DIR}/scripts/gcom/gcom-reconcile"
export PATH="${PATH}:${DEPLOY_TOOLS_DIR}/scripts/gcom"

# k9s
alias k9sdev="k9s --context dev-us-central-0 --namespace fire-dev-001"
alias k9sops="k9s --context ops-us-east-0 --namespace profiles-ops-001"
alias k9sctx="k9s --context"

# kubectx
alias ktx="kubectx -c"
alias ktxlist="kubectx -c | xargs printf 'current: %s\n\n' && kubectx | grep -vE '^pop-'"

# k8s contexts
export KUBECONFIG="$HOME/.kube/config":"$HOME/.kube/config-kind"

# profilecli
export PATH=$PATH:"${HOME}/grafana/pyroscope"

# Add google cloud sdk to path.
export PATH=$PATH:/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/bin

# Ruby
export PATH="/opt/homebrew/opt/ruby/bin:$PATH"

# jenv
export PATH="$HOME/.jenv/shims:$PATH"
if which jenv > /dev/null; then
  eval "$(jenv init -)";
fi

# depot_tools (used to build js v8 engine)
#  NOTE(bryan): Uncomment this to build Node v8 from source. Otherwise this will
#               conflict with other usages of clang-format.
# export PATH="$HOME/tools/depot_tools:$PATH"

# k6 dev config
alias k6dev="K6_CLOUD_HOST=https://ingest.staging.k6.io k6"

{{- end }}
