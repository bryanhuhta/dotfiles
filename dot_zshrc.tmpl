# Open files with Cursor
function cursor {
  /Applications/Cursor.app/Contents/MacOS/Cursor $@
}

# Run deployment tools setup-context
function deploysso() {
  cd "${DEPLOY_TOOLS_DIR}"
  ./setup-context -p google
  ./setup-context -p aws
  cd -
}

function sso() {
  local env="${1:-dev}"

  if [[ -z "${DEPLOY_TOOLS_DIR}" ]]; then
    echo "Error: DEPLOY_TOOLS_DIR is not set."
    return 1
  fi

  # Run in a subshell
  (
    cd "${DEPLOY_TOOLS_DIR}" || {
      echo "Error: Cannot cd into ${DEPLOY_TOOLS_DIR}"
      exit 1
    }

    gcloud auth login

    case "$env" in
      dev)
        ./scripts/sso/aws.sh dev
        ;;
      ops)
        ./scripts/sso/aws.sh ops
        ;;
      prod)
        ./scripts/sso/aws.sh prod
        ;;
      *)
        echo "Unknown environment: $env"
        echo "Usage: sso [dev|ops|prod]"
        exit 1
        ;;
    esac
  )
}

# Render all mermaid blocks in a markdown file.
function mermaid() {
  local output_dir=""
  local input=""

  # Parse flags
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -d|--dir)
        output_dir="$2"
        shift 2
        ;;
      *)
        input="$1"
        shift
        ;;
    esac
  done

  if [ -z "$input" ]; then
    echo "Usage: mermaid [-d output_dir] <file>"
    return 1
  fi

  if [ ! -f "$input" ]; then
    echo "Error: '$input' not found."
    return 1
  fi

  local dir
  local filename
  local base
  local ext
  local output

  dir=$(dirname "$input")
  filename=$(basename "$input")
  base="${filename%.*}"          # strip extension
  ext="${filename##*.}"          # get extension

  # Default to same directory if -d not specified
  if [ -z "$output_dir" ]; then
    output_dir="$dir"
  fi

  mkdir -p "$output_dir"
  output="${output_dir}/${base}.render.${ext}"

  docker run --rm -u "$(id -u)":"$(id -g)" \
    -v "${PWD}:/data" \
    minlag/mermaid-cli \
    -i "$input" \
    -o "$output"
}

# Delete local branches from a repository.
function gitbranchrm() {
  git for-each-ref --format '%(refname:short)' refs/heads | grep -vE 'master|main|next' | xargs git branch -d
}

function ts2date () {
  local localtime=false

  if [[ $1 == "-l" ]]; then
    localtime=true
    shift
  fi

  for ts in "$@"; do
    if $localtime; then
      node -e "console.log(new Date(${ts}).toString())"
    else
      node -e "console.log(new Date(${ts}).toUTCString())"
    fi
  done
}

function gifify {
  file="${1}"
  name=$(basename "${file}" ".webp")
  magick -format gif "${file}" "${name}.gif"
}

function slackify {
  infile="${1}"
  files=()
  if [[ -d "${infile}" ]]; then
    files=( $(ls "${infile}"/* ) )
  else
    files+="${infile}"
  fi

  outdir="${2}"
  if [[ -n "${outdir}" ]]; then
    if [[ -f "${outdir}" ]]; then
      echo "output directory is a file that already exists: ${outdir}"
      exit 1
    fi

    if [[ ! -d "${outdir}" ]]; then
      mkdir "${outdir}"
    fi
  fi

  for f in "${files[@]}"; do
    echo "slackifying ${f}"
    name=$(echo "${f}" | cut -d"." -f1)
    ext=$(echo "${f}" | cut -d"." -f2)
    outfile="${name}-slackified.${ext}"
    if [[ -n "${outdir}" ]]; then
      outfile=$(echo "${outfile}" | cut -d'/' -f2-)
      outfile="${outdir}/${outfile}"
    fi

    magick "${f}" -resize 44000000@ "${outfile}"
  done
}

function jpegify () {
  file="${1}"
  name=$(basename "${file}" ".webp")
  magick -format jpg "${file}" "${name}.jpg"
}

