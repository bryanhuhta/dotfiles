#!/bin/bash
## Convert a .mov file to .mp4 using ffmpeg (via the `utility` Docker
## container).
##
## Output is written to the same directory as the input with
## a .mp4 extension. Uses libx264 video and AAC audio encoding.
## The input path must be inside the current directory.
##
## Usage: movtomp4 [-h] <input.mov>
##   -h    Print this help message

set -euo pipefail

if [[ "${1:-}" == "-h" ]]; then
  grep '^##' "$0" | sed -E 's/^## ?//'
  exit 0
fi

input="${1:-}"
if [[ -z "$input" ]]; then
  echo "Usage: movtomp4 <input.mov>"
  exit 1
fi

output="${input%.*}.mp4"
utility ffmpeg -i "$input" -vcodec libx264 -crf 28 -preset slow -acodec aac -b:a 128k "$output"
