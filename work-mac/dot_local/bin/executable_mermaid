#!/bin/bash
## Render mermaid diagrams using Docker.
##
## Uses the minlag/mermaid-cli Docker image to render diagrams.
## Accepts one or more markdown files (renders all mermaid code
## blocks) or .mmd files (treated as raw mermaid scripts). Output
## is written alongside each input file (or to a directory
## specified with -d, shared by all inputs).
##
## Markdown input writes <name>.render.md; .mmd input writes
## <name>.render.svg.
##
## Usage: mermaid [-h] [-d output_dir] <file> [<file>...]
##   -h              Print this help message
##   -d output_dir   Write output to this directory instead of
##                   each input file's directory

set -euo pipefail

if [[ "${1:-}" == "-h" ]]; then
  grep '^##' "$0" | sed -E 's/^## ?//'
  exit 0
fi

output_dir=""
inputs=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -d|--dir)
      output_dir="$2"
      shift 2
      ;;
    *)
      inputs+=("$1")
      shift
      ;;
  esac
done

if [[ ${#inputs[@]} -eq 0 ]]; then
  echo "Usage: mermaid [-d output_dir] <file> [<file>...]"
  exit 1
fi

for input in "${inputs[@]}"; do
  if [[ ! -f "$input" ]]; then
    echo "Error: '$input' not found."
    exit 1
  fi
done

for input in "${inputs[@]}"; do
  dir=$(dirname "$input")
  filename=$(basename "$input")
  base="${filename%.*}"
  ext="${filename##*.}"

  if [[ -n "$output_dir" ]]; then
    out_dir="$output_dir"
  else
    out_dir="$dir"
  fi

  mkdir -p "$out_dir"

  if [[ "$ext" == "mmd" ]]; then
    output="${out_dir}/${base}.render.svg"
  else
    output="${out_dir}/${base}.render.${ext}"
  fi

  docker run --rm -u "$(id -u)":"$(id -g)" \
    -v "${PWD}:/data" \
    minlag/mermaid-cli \
    -i "$input" \
    -o "$output"
done
