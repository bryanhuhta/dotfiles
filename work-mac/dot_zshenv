# Env vars needed by every shell, including non-interactive (make, git
# hooks, scripts, cron). Keep this fast and side-effect-free.
#
# Do NOT set PATH here: macOS /etc/zprofile runs path_helper, which prepends
# /etc/paths entries to whatever PATH it inherits, so anything we set in
# .zshenv gets reordered. PATH lives in .zprofile.

export EDITOR=nvim

# XDG Base Directory spec. macOS does not set these by default, but many
# cross-platform tools (nvim, git, fish, ripgrep, ...) respect them.
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# Dedupe PATH; later additions that are already present become no-ops.
typeset -U path PATH
