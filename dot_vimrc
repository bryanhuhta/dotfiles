call plug#begin()

" List your plugins here
Plug 'fatih/vim-go', { 'do': ':GoUpdateBinaries' }

call plug#end()

set ruler
set relativenumber
syntax on

" Set column rulers, use a color slightly lighter than the background.
set colorcolumn=81,121
highlight ColorColumn ctermbg=235 guibg=#262626

" Display whitespace.
set list
set listchars=tab:>-,trail:.,multispace:.

" Set indents.
filetype plugin indent on
set ai
set tabstop=4
set shiftwidth=4
set expandtab

" Folding options.
set foldmethod=syntax
set nofoldenable
set foldlevel=99

" Control how vsplit and hsplit work.
set splitright
set splitbelow

" Open file explorer.
nnoremap <silent> <C-E> :Lexplore<CR>

" Toggle relative/absolute line numbers.
nnoremap <leader>r :set relativenumber! number!<CR>

" Go
let g:go_fmt_command = "goimports"

let g:go_auto_type_info = 1
set updatetime=100

let g:go_auto_sameids = 1
