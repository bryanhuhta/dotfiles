set ruler
set relativenumber

" Set column rulers, use a color slightly lighter than the background.
set colorcolumn=81,121
highlight ColorColumn ctermbg=235 guibg=#262626

" Display whitespace.
set list
set listchars=tab:>-,trail:.,multispace:.

filetype plugin indent on
set ai
set tabstop=4
set shiftwidth=4
set expandtab

syntax on
