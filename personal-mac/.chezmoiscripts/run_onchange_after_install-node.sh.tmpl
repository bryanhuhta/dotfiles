#!/bin/bash
## Install node via nvm and enable corepack, which provides yarn.
##
## nvm itself is installed by .chezmoiexternal.toml; the `after_` attribute
## makes this run after the file phase, so ~/.nvm is guaranteed to exist. The
## node version is pinned in .chezmoidata.toml — chezmoi re-runs this script
## whenever its rendered content changes, so bumping node.version (or
## nvm.version, via the sourced nvm.sh) triggers a re-run.
##
## Idempotent: an already-installed node version is left as is.

set -euo pipefail

export NVM_DIR="$HOME/.nvm"

# nvm.sh references unset variables internally, so relax -u around nvm use.
set +u
. "$NVM_DIR/nvm.sh"

nvm install {{ .node.version }}
nvm alias default {{ .node.version }}
nvm use {{ .node.version }}
set -u

# Corepack ships with node and shims yarn (and pnpm) into the active node
# version's bin directory, respecting each project's packageManager field.
corepack enable
