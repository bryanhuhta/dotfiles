# OrbStack requires this Include to be at the top of ssh_config, before any
# Host blocks. It is silently ignored on machines without OrbStack.
Include ~/.orbstack/ssh/config

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

{{- if or (eq .profile "personal") (eq .profile "") }}

Host wrightauto
  HostName 75.134.133.125
  User kyle
  Port 22
  IdentityFile ~/.ssh/wrightauto.pub
  IdentitiesOnly yes
{{- end }}
